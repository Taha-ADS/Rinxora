# Live voice agent (Retell). Copy to .env.local and fill in.
# Use a Retell PUBLIC key and restrict it to your domains in the Retell dashboard.
VITE_RETELL_PUBLIC_KEY=

# One Retell agent per voice. Only voices with an agent id appear on the live call.
# Sarah defaults to the original agent if left blank.
VITE_RETELL_AGENT_ID_SARAH=
VITE_RETELL_AGENT_ID_MARCUS=
VITE_RETELL_AGENT_ID_ARIA=

# ---- Booking: where "Book a demo" requests go. Set at least one. ----
# The demo form POSTs JSON here: Formspree (https://formspree.io/f/xxxx), Web3Forms (https://api.web3forms.com/submit),
# a Zapier/Make webhook, or your own API.
VITE_LEAD_ENDPOINT=
# Only for services that expect a key in the body (Web3Forms "access_key").
VITE_LEAD_ACCESS_KEY=
# Calendly or Cal.com link, offered after the form is sent (name and email are filled in for the lead).
VITE_BOOKING_URL=
# Shown in the footer and legal pages; the fallback when the form can't be sent.
VITE_CONTACT_EMAIL=

# ---- Legal pages (privacy.html, terms.html) ----
VITE_LEGAL_COMPANY=Rinxora Technologies
VITE_LEGAL_ADDRESS=
VITE_LEGAL_JURISDICTION=

# Public site address, used for share previews (og:image must be an absolute URL).
VITE_SITE_URL=
